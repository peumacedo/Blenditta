generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FechamentoStatus {
  EM_PREPARACAO
  PROCESSANDO
  EM_REVISAO
  FECHADO
}

enum SituacaoConta {
  PENDENTE
  PAGO
  RECEBIDO
  VENCIDO
}

enum InconsistenciaStatus {
  ABERTA
  EM_ANALISE
  RESOLVIDA
}

model Fechamento {
  id              String              @id @default(cuid())
  competencia     DateTime
  status          FechamentoStatus    @default(EM_PREPARACAO)
  observacoes     String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  arquivos        Arquivo[]
  extratos        ExtratoBancario[]
  contasPagar     ContaPagar[]
  contasReceber   ContaReceber[]
  inconsistencias Inconsistencia[]

  @@map("fechamentos")
}

model Arquivo {
  id           String     @id @default(cuid())
  fechamentoId String     @map("fechamento_id")
  nome         String
  tipo         String
  caminho      String
  criadoEm     DateTime   @default(now()) @map("criado_em")
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId])
  @@map("arquivos")
}

model ExtratoBancario {
  id           String     @id @default(cuid())
  fechamentoId String     @map("fechamento_id")
  data         DateTime
  descricao    String
  valor        Decimal    @db.Decimal(14, 2)
  saldo        Decimal    @db.Decimal(14, 2)
  categoria    String
  conciliado   Boolean    @default(false)
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId, data])
  @@map("extrato_bancario")
}

model ContaPagar {
  id           String       @id @default(cuid())
  fechamentoId String       @map("fechamento_id")
  fornecedor   String
  vencimento   DateTime
  pagamento    DateTime?
  valor        Decimal      @db.Decimal(14, 2)
  categoria    String
  situacao     SituacaoConta @default(PENDENTE)
  fechamento   Fechamento   @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId, vencimento])
  @@map("contas_pagar")
}

model ContaReceber {
  id           String       @id @default(cuid())
  fechamentoId String       @map("fechamento_id")
  cliente      String
  vencimento   DateTime
  recebimento  DateTime?
  valor        Decimal      @db.Decimal(14, 2)
  categoria    String
  situacao     SituacaoConta @default(PENDENTE)
  fechamento   Fechamento   @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId, vencimento])
  @@map("contas_receber")
}

model Inconsistencia {
  id           String               @id @default(cuid())
  fechamentoId String               @map("fechamento_id")
  tipo         String
  data         DateTime
  descricao    String
  valor        Decimal              @db.Decimal(14, 2)
  status       InconsistenciaStatus @default(ABERTA)
  observacao   String?
  fechamento   Fechamento           @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId, status])
  @@map("inconsistencias")
}
